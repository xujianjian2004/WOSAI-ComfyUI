    "promptData": {
      "yellowingCleanup": {
        "cn": "专业老照片修复，去除泛黄、色偏、污渍、霉斑和划痕，校正白平衡，保留原始人物五官、服饰和场景细节，自然真实。",
        "legacyEn": "Professional old photo restoration, remove yellowing, color cast, stains, mildew spots and scratches, correct white balance, preserve original facial features, clothing and scene details, natural and realistic.",
        "en": "Old photo restoration, remove yellow tint, fix color cast, balance white. Restore sepia/B&W film look. Clean stains, mold, scratches, aging marks. Reduce haze, boost contrast. Gently restore details, preserve facial features and expression, no oversharpen, keep vintage grain. Clear and layered."
      },
      "stainCleanup": {
        "cn": "精细清理老照片上的污渍、水渍、灰尘和霉斑，保留纸张纹理与人物细节，修复结果干净自然。",
        "legacyEn": "Carefully remove stains, water marks, dust and mildew spots from an old photo while preserving paper texture and subject details, clean and natural restoration.",
        "en": "Old photo cleanup, erase graffiti, stains, mold spots, peeling. Reconstruct face, hair, clothes. Fix yellowing, restore true colors. Reduce haze, boost contrast, enhance clarity. Keep skin texture, preserve facial features and expression, no oversharpen. Vintage film style, clear and layered."
      },
      "creaseRepair": {
        "cn": "修复老照片中的折痕、裂纹、压痕与划伤，补全连续纹理和边缘，保持人物比例、表情和背景不变。",
        "legacyEn": "Repair folds, cracks, creases and scratches in an old photo, restore continuous texture and edges, keep subject proportions, expression and background unchanged.",
        "en": "B&W photo repair, remove cracks, deep creases, peeling. Rebuild face, hair, fabric details. Fix contrast, reduce haze, brighten, restore pure grayscale. Gently restore skin texture and features, no oversharpen, protect original expression. Repair damaged edges, clean and clear, keep vintage grain."
      },
      "glareRemoval": {
        "cn": "去除照片表面的反光、高光、玻璃眩光与局部过曝，恢复被遮挡的自然细节和均衡光影。",
        "legacyEn": "Remove surface reflections, harsh highlights, glass glare and local overexposure, recover natural hidden details and balanced lighting.",
        "en": "Photo restoration, remove glass glare, light reflections, hand shadows. Reveal hidden face, preserve facial features and expression. Fix yellowing, clean damage, restore authentic film texture. Gentle processing, no oversharpen. Crop to photo only, clean edges, high clarity, no artifacts."
      },
      "damageCompletion": {
        "cn": "智能补全老照片缺失、破损和撕裂区域，延续原有纹理、光线和构图，避免改变人物身份与历史信息。",
        "legacyEn": "Intelligently complete missing, damaged and torn areas of an old photo, continue the original texture, lighting and composition without changing identity or historical details.",
        "en": "Photo inpainting, fill missing parts, fix torn edges, heavy damage. Rebuild face, strands of hair, clothing. Balance white, remove yellow tint, restore sepia/B&W film look. Reduce haze, boost contrast. Gently restore skin texture, preserve identity and expression, no oversharpen. Clean, detailed, layered."
      },
      "colorize": {
        "cn": "为黑白老照片自然上色，肤色、服饰、环境和光线符合年代与真实材质，保持清晰细节，不产生夸张饱和度。",
        "legacyEn": "Naturally colorize a black and white old photo with period-appropriate skin tones, clothing, environment and lighting, preserve clear details and avoid exaggerated saturation.",
        "en": "Colorize old B&W photo, keep original face, figure, composition and vintage film grain, do not alter appearance. Natural era-authentic colors for skin, clothes, furniture and scenery. Remove yellow stains, scratches, mold and haze, adjust contrast, soften light transitions. Retain skin and hair details, balanced saturation, no oversaturation or distortion. Realistic retro color film look, clean with period atmosphere."
      }
    },
