      "stainCleanup": "污渍清理|污斑清理|Stain cleanup",
      "creaseRepair": "折痕修复|Crease repair",
      "glareRemoval": "反光祛除|Glare removal",
      "damageCompletion": "残缺补全|Damage completion",
